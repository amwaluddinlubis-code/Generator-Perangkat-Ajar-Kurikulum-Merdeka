# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model ilustrasi AI memakai kunci yang SAMA di atas (gemini-2.5-flash-image).
# Dapatkan kunci gratis di https://aistudio.google.com → Get API key.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Login Google Belajar.id (OAuth2/OIDC resmi):
# 1. Buat OAuth Client di https://console.cloud.google.com/apis/credentials
#    (tipe "Web application").
# 2. Authorized redirect URI: <APP_URL>/api/auth/google/callback
#    (lokal: http://localhost:3000/api/auth/google/callback).
# 3. Isi ketiga variabel di bawah lalu restart server.
# Tanpa ini, tombol "Masuk dengan Google" menampilkan pesan belum dikonfigurasi
# dan login manual/simulasi tetap berfungsi.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Opsional bila APP_URL sudah benar; override eksplisit bila perlu:
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
