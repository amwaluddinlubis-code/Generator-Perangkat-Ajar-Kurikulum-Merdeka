# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Model ilustrasi AI memakai kunci yang SAMA di atas (gemini-2.5-flash-image).
# Dapatkan kunci gratis di https://aistudio.google.com → Get API key.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SEED_PASSWORD: kata sandi awal akun seed.
# - Pengembangan lokal: jika kosong dipakai "guru123".
# - Produksi (NODE_ENV=production): WAJIB diisi minimal 12 karakter; jika kosong
#   server membuat kata sandi acak sekali-pakai dan mencetaknya sekali ke log.
# SEED_PASSWORD=""

# ENABLE_DEMO_LOGIN: set "1" hanya bila benar-benar butuh tombol login demo
# di produksi. Default: login demo mati di production, hidup di luar production.
# ENABLE_DEMO_LOGIN="0"

# RGM_DB_PATH: lokasi file SQLite (opsional). Default: data/rgm.sqlite.
# RGM_UPLOAD_DIR: folder berkas unggahan/gambar (opsional). Default: data/uploads.
# Di Render, arahkan keduanya ke mount disk permanen agar data tidak hilang.
# RGM_DB_PATH=""
# RGM_UPLOAD_DIR=""
