rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for ID validation
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Teachers & Educators Directory
    match /teachers/{teacherId} {
      allow read: if true;
      allow create: if isValidId(teacherId) && request.resource.data.email is string && request.resource.data.name is string;
      allow update: if isValidId(teacherId);
      allow delete: if isValidId(teacherId);
    }

    // Educational Documents Repository (Modul Ajar, RPP, Soal AKM, etc.)
    match /documents/{documentId} {
      allow read: if true;
      allow create: if isValidId(documentId) && request.resource.data.title is string && request.resource.data.content is string;
      allow update: if isValidId(documentId);
      allow delete: if isValidId(documentId);
    }

    // System Connection Health Check
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
